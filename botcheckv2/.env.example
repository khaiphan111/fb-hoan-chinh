# FB Live/Die Checker — Tác giả: @nhanxp
# Các biến môi trường cần thiết khi deploy lên Render.

# [BẮT BUỘC] URL kết nối PostgreSQL (Supabase hoặc dịch vụ khác)
# Lấy từ: Supabase → Project Settings → Database → Connection String (URI)
SUPABASE_DB_URL=postgresql://user:password@host:5432/dbname

# Đánh dấu đang chạy trên Render (tự động set bởi render.yaml)
# RENDER=true

# [Tuỳ chọn] Bot Token Telegram — hoặc nhập trong trang Cấu hình web
# BOT_TOKEN=

# [Tuỳ chọn] Mật khẩu admin — mặc định: Khai16022006$
# ADMIN_PASSWORD=admin
