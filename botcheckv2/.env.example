# FB Live/Die Checker — Tác giả: @nhanxp
# Các biến môi trường cần thiết khi deploy lên Render.

# [BẮT BUỘC] URL kết nối PostgreSQL (Supabase hoặc dịch vụ khác)
# Lấy từ: Supabase → Project Settings → Database → Connection String (URI)
SUPABASE_DB_URL=postgresql://user:password@host:5432/dbname

# Đánh dấu đang chạy trên Render (tự động set bởi render.yaml)
# RENDER=true

# [Tuỳ chọn] Bot Token Telegram — hoặc nhập trong trang Cấu hình web
# BOT_TOKEN=

# [Tuỳ chọn — KHUYẾN NGHỊ ĐẶT] Khoá ký token đăng nhập admin/user.
# Nếu để trống, hệ thống tự sinh ngẫu nhiên 1 lần và lưu vào DB (settings.app_secret).
# Đặt cố định giá trị này giúp token không bị vô hiệu khi đổi/khôi phục DB.
# APP_SECRET=

# [Tuỳ chọn] Mật khẩu super-admin đặt khi TẠO DB lần đầu.
# Nếu để trống, hệ thống sinh mật khẩu ngẫu nhiên và IN RA LOG khởi động
# (vào web admin đổi lại ngay sau lần đăng nhập đầu).
# ADMIN_PASSWORD=
